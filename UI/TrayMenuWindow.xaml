<Window x:Class="CaretHUD.UI.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Focusable="True">
    <Window.Resources>
        <Style x:Key="MenuItemButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E8ECF2" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="34" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A404B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Border Background="#F22A2F38"
                CornerRadius="10"
                Padding="6"
                Width="220">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.45" Color="#000000" />
            </Border.Effect>
            <StackPanel>
                <Button x:Name="AboutButton" Style="{StaticResource MenuItemButton}" Click="OnAboutClick">
                    <TextBlock Text="说明" FontSize="13" VerticalAlignment="Center" />
                </Button>
                <Button x:Name="TrimButton" Style="{StaticResource MenuItemButton}" Click="OnTrimClick">
                    <TextBlock Text="释放内存" FontSize="13" VerticalAlignment="Center" />
                </Button>
                <Rectangle Height="1" Fill="#3A404B" Margin="10,4" />
                <Button x:Name="ExitButton" Style="{StaticResource MenuItemButton}" Click="OnExitClick">
                    <TextBlock Text="退出" FontSize="13" VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>

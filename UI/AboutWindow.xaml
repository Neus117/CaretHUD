<Window x:Class="CaretHUD.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Focusable="True">
    <Window.Resources>
        <Style x:Key="AboutButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3A404B" />
            <Setter Property="Foreground" Value="#E8ECF2" />
            <Setter Property="Padding" Value="18,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A5160" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Border Background="#2A2F38"
                CornerRadius="10"
                Padding="20"
                Width="360">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="#000000" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="CaretHUD" FontSize="18" FontWeight="Bold" Foreground="#E8ECF2" />
                <TextBlock Text="在输入光标旁显示中英文、大小写和数字键盘状态。"
                           FontSize="13"
                           Foreground="#B8C0CC"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0" />
                <TextBlock Text="支持：经典输入框、Chrome / Edge / Electron、QQ、Word"
                           FontSize="12"
                           Foreground="#8F98A6"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0" />
                <TextBlock Text="不显示：管理员权限窗口、UWP 应用、全屏独占应用"
                           FontSize="12"
                           Foreground="#8F98A6"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
                <Button Content="关闭"
                        Style="{StaticResource AboutButtonStyle}"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0"
                        Click="OnCloseClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

<Window x:Class="CaretHUD.UI.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CaretHUD"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Focusable="False"
        IsHitTestVisible="False"
        Left="-10000"
        Top="-10000">
    <Grid Margin="16">
        <Border x:Name="Root"
                CornerRadius="10"
                Background="#E6222730"
                Padding="10,5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.45" Color="#000000" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="ImeText"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#F5F7FA"
                           VerticalAlignment="Center"
                           Text="中" />
                <Border x:Name="CapsBadge"
                        Visibility="Collapsed"
                        Margin="8,0,0,0"
                        CornerRadius="4"
                        Background="#33F5A623"
                        Padding="4,1"
                        VerticalAlignment="Center">
                    <TextBlock Text="A" FontSize="11" FontWeight="Bold" Foreground="#F5A623" />
                </Border>
                <Border x:Name="NumBadge"
                        Visibility="Collapsed"
                        Margin="8,0,0,0"
                        CornerRadius="4"
                        Background="#26FF6B6B"
                        Padding="4,2"
                        VerticalAlignment="Center">
                    <Canvas Width="11" Height="11">
                        <Ellipse Width="2" Height="2" Canvas.Left="0.5" Canvas.Top="0.5" Fill="#FF6B6B" />
                        <Ellipse Width="2" Height="2" Canvas.Left="4.5" Canvas.Top="0.5" Fill="#FF6B6B" />
                        <Ellipse Width="2" Height="2" Canvas.Left="8.5" Canvas.Top="0.5" Fill="#FF6B6B" />
                        <Ellipse Width="2" Height="2" Canvas.Left="0.5" Canvas.Top="4.5" Fill="#FF6B6B" />
                        <Ellipse Width="2" Height="2" Canvas.Left="4.5" Canvas.Top="4.5" Fill="#FF6B6B" />
                        <Ellipse Width="2" Height="2" Canvas.Left="8.5" Canvas.Top="4.5" Fill="#FF6B6B" />
                        <Ellipse Width="2" Height="2" Canvas.Left="0.5" Canvas.Top="8.5" Fill="#FF6B6B" />
                        <Ellipse Width="2" Height="2" Canvas.Left="4.5" Canvas.Top="8.5" Fill="#FF6B6B" />
                        <Ellipse Width="2" Height="2" Canvas.Left="8.5" Canvas.Top="8.5" Fill="#FF6B6B" />
                        <Line X1="-0.5" Y1="11.5" X2="11.5" Y2="-0.5" Stroke="#FF6B6B" StrokeThickness="1.2" />
                    </Canvas>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
